<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ultron" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Ultron.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1C1B1F</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Ultron</item>
    </style>
</resources>
