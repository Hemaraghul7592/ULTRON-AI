# =============================================================================
# ULTRON Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# =============================================================================

# --- Database ---------------------------------------------------------------
# SQLite (development):
DATABASE_URL=sqlite+aiosqlite:///./ultron.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://ultron:changeme@localhost:5432/ultron
DB_ECHO=false

# --- Security ---------------------------------------------------------------
# Generate: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI Providers ----------------------------------------------------------
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
DEFAULT_AI_PROVIDER=groq
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096

# --- External APIs ----------------------------------------------------------
OPEN_WEATHER_API_KEY=
OCR_API_KEY=
# Get your API key at: https://app.tavily.com
TAVILY_API_KEY=tvly-...

# --- Google OAuth2 -----------------------------------------------------------
# GOOGLE_REFRESH_TOKEN is NOT stored in .env.
# It is automatically obtained via OAuth and stored encrypted in the database.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=

# --- GitHub ------------------------------------------------------------------
# Create a GitHub Personal Access Token (classic) with 'repo' scope
# or a fine-grained token with 'Contents' read permission.
# Go to: https://github.com/settings/tokens
GITHUB_TOKEN=github_pat_...

# --- Notion ------------------------------------------------------------------
NOTION_API_KEY=ntn_...

# --- Voice -------------------------------------------------------------------
TTS_ENABLED=true
STT_ENABLED=true
WAKE_WORD_ENABLED=false
TTS_MODEL=tts-1
STT_MODEL=whisper-1

# --- Redis -------------------------------------------------------------------
# Leave empty to fall back to in-memory rate limiting
REDIS_URL=
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Server ------------------------------------------------------------------
LOG_LEVEL=INFO
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]
APP_NAME=ULTRON
APP_VERSION=1.0.0

# --- Performance -------------------------------------------------------------
MAX_CONCURRENT_JOBS=10
EMBEDDING_DIM=384

# --- Memory ------------------------------------------------------------------
MEMORY_SHORT_TERM_MAX=50
MEMORY_LONG_TERM_THRESHOLD=0.7
MEMORY_SUMMARIZATION_THRESHOLD=10
